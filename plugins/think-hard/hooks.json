{
  "think-hard-hook": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/lib/ensure-hud.mjs",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/think-hard-hook.mjs pre",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/think-hard-hook.mjs stop",
        "timeout": 10
      }
    ]
  }
}
