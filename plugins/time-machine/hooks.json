{
  "time-machine-hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/tm-hook.mjs session-start",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/tm-hook.mjs pre-invocation",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/tm-hook.mjs pre-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/tm-hook.mjs stop",
        "timeout": 25
      }
    ]
  }
}
