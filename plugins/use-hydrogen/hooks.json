{
  "use-hydrogen-hook": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/lib/ensure-hud.mjs",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/use-hydrogen-hook.mjs pre",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/use-hydrogen-hook.mjs stop",
        "timeout": 10
      }
    ]
  }
}
