{
  "use-hydrogen-hook": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/lib/hook-gate.sh ensure-hud",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/lib/hook-gate.sh use-hydrogen-pre",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/lib/hook-gate.sh use-hydrogen-stop",
        "timeout": 10
      }
    ]
  }
}
